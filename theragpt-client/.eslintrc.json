{
  "extends": ["next/babel", "next/core-web-vitals"],
  "rules": {
    "react-hooks/exhaustive-deps": "off",
    "import/order": [
      "error",
      {
        "alphabetize": {
          "caseInsensitive": true
        },
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "pathGroups": [
          {
            "group": "external",
            "pattern": "next/**",
            "position": "before"
          },
          {
            "group": "external",
            "pattern": "react",
            "position": "before"
          },
          {
            "group": "external",
            "pattern": "@mui/**",
            "position": "after"
          },
          {
            "pattern": "components/**",
            "group": "internal"
          },
          {
            "pattern": "styles/**",
            "group": "internal"
          }
        ],
        "pathGroupsExcludedImportTypes": ["react"]
      }
    ]
  }
}
